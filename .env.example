# ── Supabase ──────────────────────────────────────────────────────────
# Copia este archivo a `.env` y rellena con los valores de tu proyecto
# (Supabase → Project Settings → API). El `.env` está git-ignorado.

# PÚBLICAS — van al bundle del navegador. Es SEGURO que sean públicas
# siempre que RLS esté activo (ver supabase/migrations/..._functions_rls.sql).
PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── SOLO LOCAL · NUNCA COMMIT · NUNCA EN EL BUNDLE ────────────────────
# service_role saltea RLS por completo. Solo para `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Para el CLI de Supabase (`supabase link`, `supabase db push`).
# Genera el token en https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# Password de la base de datos (Project Settings → Database).
SUPABASE_DB_PASSWORD=...
