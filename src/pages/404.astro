---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sticker Vault | Página no encontrada"
  description="Página no encontrada en Sticker Vault."
  path="/404"
  active="index"
  bodyClass="home-page"
  noindex
>
  <section class="catalog-hero">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe.</h1>
      <p class="hero-copy">
        El enlace que seguiste no lleva a ningún sticker.
        <a href="/">Volver al catálogo</a>.
      </p>
    </div>
  </section>
</BaseLayout>
