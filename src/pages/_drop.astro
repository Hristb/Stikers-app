---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MysteryOverlay from '../components/MysteryOverlay.astro';
import CustomizeOverlay from '../components/CustomizeOverlay.astro';

const products = await getCollection('products');
const sprites = products
  .filter(p => p.data.category === 'fortnite')
  .map(p => ({ id: p.id, name: p.data.name, image: p.data.image, rarity: p.data.rarity, rarityLabel: p.data.rarityLabel }));

// Vitrinas estáticas (Mystery Pack / Custom Pack) — antes eran los mismos
// 12 sprites hardcodeados en el HTML; ahora se toman de las 12 primeras
// entradas de fortnite del catálogo real para no duplicar datos.
const showcase = sprites.slice(0, 12);
const bubblePositions = ['b1', 'b2', 'b3', 'b4', 'b5'];
const miniPositions = ['m1', 'm2', 'm3', 'm4'];

const finishes = await getCollection('finishes');
const finishesData = finishes.map(f => f.data);
---
<BaseLayout
  title="Sticker Vault | Drop"
  description="Drop exclusivo de Sticker Vault — Pack Sorpresa y Pack Personalizado. 10 stickers en vinil resistente al agua, impresión HD."
  ogTitle="Sticker Vault | Drop — Pack Sorpresa y Pack Personalizado"
  ogDescription="10 stickers en vinil resistente al agua, impresión HD. Pide por WhatsApp."
  path="/drop"
  active="drop"
>
  <section class="hero">
    <p class="eyebrow">Nuevo drop exclusivo</p>
    <h1>Stickers para la próxima victoria.</h1>
    <p class="hero-copy">Colección premium para gamers con estilo épico, acabado resistente y diseño pensado para cada partida.</p>
  </section>

  <section class="shop-grid" aria-label="Sticker packs">
    <article class="offer-card surprise">
      <div class="card-head">
        <span class="pill pill-purple">Mystery Pack</span>
        <span class="price-tag">S/ 8.50</span>
      </div>

      <h2>Pack Sorpresa</h2>

      <div class="mystery-stage" aria-hidden="true">
        <div class="mystery-art">
          <div class="gift-lid"></div>
          <div class="gift-box"></div>
          {bubblePositions.map((pos, i) => showcase[i] && (
            <div class={`sticker-bubble ${pos}`}><img src={showcase[i].image} alt={showcase[i].name} /></div>
          ))}
          {miniPositions.map((pos, i) => showcase[i + 5] && (
            <div class={`mini-sticker ${pos}`}><img src={showcase[i + 5].image} alt={showcase[i + 5].name} /></div>
          ))}
        </div>
      </div>

      <div class="cta-row">
        <button class="primary-btn" onclick="openMystery()">Elegir pack</button>
      </div>
    </article>

    <article class="offer-card custom">
      <div class="card-head">
        <span class="pill pill-blue">Custom Pack</span>
        <span class="price-tag">S/ 8.50</span>
      </div>

      <h2>Pack Personalizado</h2>

      <div class="custom-grid" aria-label="Sticker selector grid">
        {showcase.map(s => (
          <div class="tile"><img src={s.image} alt={s.name} /></div>
        ))}
      </div>

      <div class="cta-row">
        <button class="secondary-btn" onclick="openCustomize()">Diseñar pack</button>
      </div>
    </article>
  </section>

  <div class="product-detail" aria-label="Product details">
    <span class="price-line">S/ 8.50 por 10 stickers</span>
    <span class="dot">•</span>
    <span>Waterproof Vinyl</span>
    <span class="dot">•</span>
    <span>HD Print</span>
  </div>

  <MysteryOverlay />
  <CustomizeOverlay />

  <Fragment slot="scripts">
    <script type="application/json" id="sprites-json" set:html={JSON.stringify(sprites)} />
    <script type="application/json" id="finishes-json" set:html={JSON.stringify(finishesData)} />
    <script src="../scripts/mystery-pack.js"></script>
    <script src="../scripts/customize-pack.js"></script>
  </Fragment>
</BaseLayout>
